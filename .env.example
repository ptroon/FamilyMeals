# FamilyMeals Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=super-secret-family-meals-jwt-token-key-2026
DATABASE_PATH=data/familymeals.db

# Admin Default Credentials (seeded on first start)
DEFAULT_ADMIN_EMAIL=admin@familymeals.local
DEFAULT_ADMIN_PASSWORD=AdminFamilyMeals123!

# Google AI Gemini API Key (Optional: for AI Recipe Parser and AI Meal Planner)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Base URL for short links and emails
APP_URL=http://localhost:3000

# SMTP Configuration (can also be configured via Admin UI in the app)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=meals@familymeals.local
SMTP_FROM_NAME="FamilyMeals Kitchen"

